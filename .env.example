# Copy this file to .env and change the values. .env is git-ignored; never commit it.

# The database. The password has no default on purpose: compose refuses to start without one.
POSTGRES_DB=restaurant_orders
POSTGRES_USER=restaurant_orders
POSTGRES_PASSWORD=change-me

# The port the app is published on (http://localhost:8088).
APP_PORT=8088

# true when the app is served over HTTPS (the session cookie is then never sent over plain HTTP).
SESSION_COOKIE_SECURE=false

# true loads the demo menu, tables and staff (every account has PIN 1234) into an empty database.
# For a demo only: turn it off, or change every PIN in Staff accounts, before real use.
APP_SEED_DEMO=false

# The first administrator. On an EMPTY installation these create the first admin (and a kitchen account, if you also
# set the two kitchen values), so you can sign in without the demo data. Names are free text, PINs are 4 to 8 digits.
# They never change an installation that already has accounts. Once you have signed in, REMOVE the PINs from this file.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PIN=
BOOTSTRAP_KITCHEN_NAME=
BOOTSTRAP_KITCHEN_PIN=

# Recovery when every administrator PIN is lost: set the admin name and a NEW PIN above, set this to true, start once,
# then remove it again together with the PIN. Resets only that existing administrator; creates nothing.
BOOTSTRAP_ADMIN_RESET=false

# Only for docker-compose.hub.yml (the images published on Docker Hub): the release to run. Pin one (for example
# 0.1.0); "latest" follows the newest release and "edge" the newest build of master.
APP_VERSION=latest
